{
  "name": "lightleakpvp",
  "version": "0.1.0",
  "description": "A team PvP spin-off of Lightleak: photograph things, develop them somewhere else at the size they looked, and use that to hold the plates and knock out the other team.",
  "private": true,
  "main": "desktop/main.js",
  "author": "Jonah Saunders",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js --lan",
    "desktop": "electron .",
    "test": "node test/run.mjs",
    "web": "node tools/webbuild.js",
    "icon": "node tools/icon.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "smoke": "electron . --smoke",
    "shots": "electron . --shots"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.jonahsaunders.lightleakpvp",
    "productName": "Lightleak PvP",
    "files": [
      "index.html",
      "server.js",
      "js/**",
      "shared/**",
      "vendor/**",
      "maps/**",
      "desktop/**",
      "LICENSES.md",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LightleakPvP-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "LightleakPvP-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "category": "public.app-category.action-games",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "LightleakPvP-${version}-mac.${ext}"
    },
    "asar": false
  }
}
